# STC-MOD: S3 storage settings for docker-compose.s3.yml
# Copy to s3.env and fill in. Never commit s3.env.

# Volume name (letters, digits, hyphen; 3-63 chars). Also used as the object key prefix in the bucket.
JFS_NAME=sillytavern

# Bucket URL. The bucket must already exist.
#   Cloudflare R2:  https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>
#   Backblaze B2:   https://s3.<REGION>.backblazeb2.com/<BUCKET>   (e.g. s3.us-west-004.backblazeb2.com)
JFS_BUCKET=https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>

# S3 API credentials (R2: API token Access Key ID / Secret; B2: Application Key ID / Application Key)
JFS_ACCESS_KEY=
JFS_SECRET_KEY=

# Metadata database (file tree: names, directories, which objects make up each file).
# Option A - cloud MariaDB / MySQL (default). Create an empty database first, e.g.:
#   CREATE DATABASE juicefs CHARACTER SET utf8mb4;
#   CREATE USER 'juicefs'@'%' IDENTIFIED BY '...';  GRANT ALL ON juicefs.* TO 'juicefs'@'%';
# Put the password in META_PASSWORD (no URL-escaping needed) and leave it out of the URL.
# Add "?tls=true" to the URL if the cloud database requires TLS.
JFS_META_URL=mysql://juicefs:@(<DB_HOST>:3306)/juicefs
META_PASSWORD=
#
# Option B - bundled local Redis: start with `--profile redis` and use
# JFS_META_URL=redis://redis:6379/1

# Local read cache size in MiB (default 10 GiB). Frequently read files are served from local disk.
JFS_CACHE_SIZE_MIB=10240

# Days deleted or overwritten files stay in the JuiceFS trash before being purged (0 disables the trash).
# Applied on every start of the juicefs container. Every save keeps the replaced version for this many
# days, so busy sites may prefer 1-2.
JFS_TRASH_DAYS=7

# Interval for automatic metadata backups into the bucket (meta/ prefix). 0 disables.
JFS_BACKUP_META=1h

# Write-back cache: 0 = off (default), 1 = on (also true/yes/on, any case; an unknown value leaves it
# off and logs a warning).
# Off: every save waits until the file is uploaded to the bucket (about 0.3-0.6 s per file on a remote
# bucket, during which the whole server is blocked). On: a save only writes to the local disk and
# returns in a few ms; the data is staged in ./juicefs/cache/<volume UUID>/rawstaging and uploaded in
# the background, usually within a second (a burst of 200 files: a few seconds).
# While it is on, recently saved data exists only on this disk until it is uploaded:
#   - Restarting, stopping or crashing the containers or the juicefs process is safe: the upload resumes
#     when juicefs starts again with the same cache directory.
#   - An unclean shutdown of the whole server (power loss, kernel panic, hard reset, VM killed) is NOT:
#     JuiceFS does not fsync staged blocks, so blocks not uploaded yet can be lost or cut short. Files
#     saved in the last second or so (up to about 30 s while the bucket is slow or unreachable) are then
#     still listed but cannot be read (I/O error). SillyTavern rewrites whole files, so a whole chat or
#     settings file is affected, not only the last message; the previous version stays in the JuiceFS
#     trash (JFS_TRASH_DAYS). With write-back off, a server crash never loses a completed save.
#     After such a crash run `juicefs fsck` and restore the broken files from the trash (README, S3
#     section "8. 写回缓存"). Blocks cut short are reported as "stuck" at every start and by the
#     pending command below; JuiceFS never uploads them and logs "Open staging file ...: invalid file
#     size" every minute until the broken files are deleted (from the trash too, see README).
#   - If ./juicefs/cache is deleted or the disk is lost while blocks are pending, those files stay listed
#     but can no longer be read. Never delete ./juicefs/cache while anything is pending.
#   - Pending uploads (pending: 0 = everything is in the bucket; stuck blocks are listed separately):
#       docker compose -f docker-compose.s3.yml exec juicefs sh /juicefs-entrypoint.sh pending
#     With juicefs stopped: find ./juicefs/cache/*/rawstaging -type f ! -name '*.tmp' | wc -l
#     (0 = nothing pending; it also counts stuck blocks, as does the metric juicefs_staging_blocks).
#   - Before a backup, moving to another server or restoring the metadata elsewhere: stop sillytavern,
#     wait until pending is 0, then stop juicefs (or move ./juicefs/cache together with the metadata).
#   - When the cache disk has less than 5% free space, JuiceFS stops staging and uploads directly
#     (saves are slow again, nothing is lost).
#   - While the bucket is unreachable, saves still succeed and pile up in rawstaging (uploaded
#     automatically once it is reachable again); check the pending count after bucket outages.
# Turning it off again with blocks still pending: the entrypoint keeps write-back on for that run so
# they get uploaded (JuiceFS only uploads staged blocks in write-back mode); recreate juicefs once
# pending is 0 to really turn it off. Stuck blocks do not keep it on.
# Apply changes with: docker compose -f docker-compose.s3.yml up -d --force-recreate juicefs sillytavern
JFS_WRITEBACK=0
